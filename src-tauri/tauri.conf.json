{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "downloader",
  "version": "0.1.0",
  "identifier": "com.mtr.downloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "downloader",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mtr",
    "shortDescription": "YouTube Audio/Video Downloader",
    "longDescription": "A tool to download audio and video from YouTube without external dependencies.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries": "./binaries",
      "resources/THIRD-PARTY.md": "THIRD-PARTY.md"
    }
  }
}
