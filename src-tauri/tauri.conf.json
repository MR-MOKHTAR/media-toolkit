{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaToolkit",
  "version": "1.2.0",
  "identifier": "com.mtr.downloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Toolkit",
        "width": 1100,
        "height": 740,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "center": true,
        "maximized": true,
        "backgroundColor": "#0c111a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "publisher": "Mokhtar Mohammadi",
    "shortDescription": "Download and edit media, offline",
    "longDescription": "Download video and audio from the web, then compress, trim, convert it, or pull the audio track out of it. yt-dlp and FFmpeg are bundled, so nothing else has to be installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries": "./binaries",
      "resources/THIRD-PARTY.md": "THIRD-PARTY.md"
    }
  }
}
