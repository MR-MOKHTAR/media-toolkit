          "archive": "raw",
          "member": null,
          "install_as": "yt-dlp",
          "sha256": null
        },
        "macos-x86_64": {
          "url": "https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/latest/download/yt-dlp_macos",
          "archive": "raw",
          "member": null,
